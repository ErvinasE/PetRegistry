<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.petregistry.controller.UsersTabController">

    <!-- Filter bar. An empty filter means "don't filter by this". -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Label text="Paieška:"/>
            <TextField fx:id="textFilter" onAction="#onSearch" prefWidth="220.0"
                       promptText="Prisijungimo vardas, vardas ar el. paštas"/>
            <Label text="Pareigos:"/>
            <ComboBox fx:id="roleFilter" prefWidth="180.0" promptText="Visos"/>
            <Button onAction="#onSearch" text="Ieškoti"/>
            <Button onAction="#onShowAll" text="Rodyti visus"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">
            <placeholder>
                <Label text="Vartotojų nerasta"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="Prisijungimo vardas">
                    <cellValueFactory>
                        <PropertyValueFactory property="username"/>
                    </cellValueFactory>
                </TableColumn>
                <!-- "fullName" works too: there is a getFullName() even without a field -->
                <TableColumn text="Vardas, pavardė">
                    <cellValueFactory>
                        <PropertyValueFactory property="fullName"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="El. paštas">
                    <cellValueFactory>
                        <PropertyValueFactory property="email"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Telefonas">
                    <cellValueFactory>
                        <PropertyValueFactory property="phone"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Pareigos">
                    <cellValueFactory>
                        <PropertyValueFactory property="role"/>
                    </cellValueFactory>
                </TableColumn>
                <!-- Only managers and caretakers have a company: the controller fills these two with lambdas -->
                <TableColumn fx:id="companyColumn" text="Įmonė"/>
                <TableColumn fx:id="blockedColumn" text="Užblokuotas"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Button onAction="#onNew" text="Naujas"/>
            <Button onAction="#onEdit" text="Redaguoti"/>
            <Button onAction="#onDelete" text="Šalinti"/>
            <!-- The text follows the selected user: "Blokuoti" or "Atblokuoti" -->
            <Button fx:id="blockButton" onAction="#onToggleBlocked" text="Blokuoti"/>
        </HBox>
    </bottom>
</BorderPane>
