<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.petregistry.controller.PetsTabController">

    <!-- Filter bar. An empty filter means "don't filter by this". -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Label text="Vardas:"/>
            <TextField fx:id="nameFilter" onAction="#onSearch" prefWidth="140.0" promptText="Vardo dalis"/>
            <Label text="Rūšis:"/>
            <ComboBox fx:id="speciesFilter" prefWidth="130.0" promptText="Visos"/>
            <Label text="Šeimininkas:"/>
            <ComboBox fx:id="ownerFilter" prefWidth="170.0" promptText="Visi"/>
            <Button onAction="#onSearch" text="Ieškoti"/>
            <Button onAction="#onShowAll" text="Rodyti visus"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">
            <placeholder>
                <Label text="Gyvūnų nerasta"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <!-- PropertyValueFactory "name" calls pet.getName() (needs "opens ...model to javafx.base") -->
                <TableColumn text="Vardas">
                    <cellValueFactory>
                        <PropertyValueFactory property="name"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Rūšis">
                    <cellValueFactory>
                        <PropertyValueFactory property="species"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Dydis">
                    <cellValueFactory>
                        <PropertyValueFactory property="size"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Gimimo data">
                    <cellValueFactory>
                        <PropertyValueFactory property="birthDate"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Svoris (kg)">
                    <cellValueFactory>
                        <PropertyValueFactory property="weightKg"/>
                    </cellValueFactory>
                </TableColumn>
                <!-- A nested value (pet.getOwner().getFullName()): the controller sets it with a lambda -->
                <TableColumn fx:id="ownerColumn" text="Šeimininkas"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Button onAction="#onNew" text="Naujas"/>
            <Button onAction="#onEdit" text="Redaguoti"/>
            <Button onAction="#onDelete" text="Šalinti"/>
        </HBox>
    </bottom>
</BorderPane>
