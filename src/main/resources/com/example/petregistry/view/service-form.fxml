<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.petregistry.controller.ServiceFormController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>

    <center>
        <!-- "*" = required -->
        <GridPane hgap="8.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="120.0"/>
                <ColumnConstraints prefWidth="320.0"/>
            </columnConstraints>

            <Label text="Įmonė *" GridPane.rowIndex="0"/>
            <ComboBox fx:id="companyBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Pavadinimas *" GridPane.rowIndex="1"/>
            <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Aprašymas" GridPane.rowIndex="2"/>
            <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Tipas *" GridPane.rowIndex="3"/>
            <ComboBox fx:id="typeBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Kaina (€) *" GridPane.rowIndex="4"/>
            <TextField fx:id="priceField" promptText="pvz. 25,00" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <!-- The controller gives it the min / max / step (15) in initialize() -->
            <Label text="Trukmė (min.) *" GridPane.rowIndex="5"/>
            <Spinner fx:id="durationSpinner" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Vieta *" GridPane.rowIndex="6"/>
            <ComboBox fx:id="locationBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            <!-- Edit mode only: a new service is always ACTIVE -->
            <Label fx:id="statusLabel" text="Būsena" GridPane.rowIndex="7"/>
            <ComboBox fx:id="statusBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

            <!-- Empty here: the controller adds one CheckBox per enum value (Species.values(), PetSize.values()) -->
            <Label text="Gyvūnų rūšys *" GridPane.rowIndex="8"/>
            <FlowPane fx:id="speciesPane" hgap="10.0" vgap="6.0" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

            <Label text="Dydžiai *" GridPane.rowIndex="9"/>
            <FlowPane fx:id="sizesPane" hgap="10.0" vgap="6.0" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <padding>
                <Insets top="12.0"/>
            </padding>
            <Button fx:id="saveButton" defaultButton="true" onAction="#onSave" text="Išsaugoti"/>
            <Button fx:id="cancelButton" cancelButton="true" onAction="#onCancel" text="Atšaukti"/>
        </HBox>
    </bottom>
</BorderPane>
