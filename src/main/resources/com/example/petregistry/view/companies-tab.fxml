<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.petregistry.controller.CompaniesTabController">

    <!-- Filter bar. An empty filter means "don't filter by this". -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Label text="Pavadinimas:"/>
            <TextField fx:id="nameFilter" onAction="#onSearch" prefWidth="160.0" promptText="Pavadinimo dalis"/>
            <Label text="Miestas:"/>
            <TextField fx:id="cityFilter" onAction="#onSearch" prefWidth="130.0" promptText="Miesto dalis"/>
            <Button onAction="#onSearch" text="Ieškoti"/>
            <Button onAction="#onShowAll" text="Rodyti visus"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">
            <placeholder>
                <Label text="Įmonių nerasta"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="Pavadinimas">
                    <cellValueFactory>
                        <PropertyValueFactory property="name"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Įmonės kodas">
                    <cellValueFactory>
                        <PropertyValueFactory property="companyCode"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Miestas">
                    <cellValueFactory>
                        <PropertyValueFactory property="city"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn text="Adresas">
                    <cellValueFactory>
                        <PropertyValueFactory property="address"/>
                    </cellValueFactory>
                </TableColumn>
                <!-- Computed values (Taip/Ne, list sizes): set in the controller with lambdas -->
                <TableColumn fx:id="activeColumn" text="Aktyvi"/>
                <TableColumn fx:id="servicesColumn" text="Paslaugų"/>
                <TableColumn fx:id="caretakersColumn" text="Prižiūrėtojų"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Button onAction="#onNew" text="Nauja"/>
            <Button onAction="#onEdit" text="Redaguoti"/>
            <Button onAction="#onDelete" text="Šalinti"/>
        </HBox>
    </bottom>
</BorderPane>
